{
  "name": "@gabrielrufino/matchjs",
  "version": "1.3.1",
  "description": "A flexible pattern matching library for JavaScript and TypeScript",
  "author": "Gabriel Rufino <contato@gabrielrufino.com>",
  "license": "Unlicense",
  "homepage": "https://github.com/gabrielrufino/matchjs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielrufino/matchjs.git"
  },
  "bugs": {
    "url": "https://github.com/gabrielrufino/matchjs/issues"
  },
  "keywords": [
    "match",
    "pattern-matching",
    "switch",
    "conditional",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run",
    "test:cov": "npm run test -- --coverage",
    "test:mutation": "npx stryker run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dequal": "^2.0.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.3",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
